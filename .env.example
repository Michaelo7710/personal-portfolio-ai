# ==============================================================================
# Environment Configuration Template (.env.example)
# Personal Portfolio AI & ATS-Friendly CV Engine
# ==============================================================================
# Copy this file to .env.local for local development:
#   cp .env.example .env.local
# DO NOT commit .env.local to version control (protected by .gitignore).
# ==============================================================================

# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# AI Configuration (Powered by Google Gemini 1.5 Flash via AI SDK)
# Obtain a free API key at https://aistudio.google.com/
AI_DEFAULT_PROVIDER=google
GOOGLE_GENERATIVE_AI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Feature Toggles (Lean Personal Portfolio Defaults)
NEXT_PUBLIC_ENABLE_AI=true
NEXT_PUBLIC_ENABLE_CONTACT=true
NEXT_PUBLIC_ENABLE_AUTH=false
NEXT_PUBLIC_ENABLE_WAITLIST=false
NEXT_PUBLIC_ENABLE_PAYMENTS=false
NEXT_PUBLIC_ENABLE_ADMIN=false

# Supabase Configuration (Optional: Required only if Auth or Persistent Storage is enabled)
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Contact & Email Configuration (Resend - Optional)
RESEND_API_KEY=
EMAIL_FROM=Mikail Nurwahid <noreply@yourdomain.com>
ADMIN_EMAILS=your-email@example.com

# Payment Providers (Disabled by default in portfolio edition)
PAYMENT_PROVIDER=midtrans
DOKU_CLIENT_ID=
DOKU_SECRET_KEY=
MIDTRANS_SERVER_KEY=
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=
